{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roblox UI Builder",
  "version": "0.3.0",
  "identifier": "dev.rblxui.builder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Roblox UI Builder",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.rbxcdn.com; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Visual builder for Roblox UI",
    "fileAssociations": [
      {
        "ext": [
          "rblxui"
        ],
        "name": "Roblox UI",
        "description": "Roblox UI Builder document",
        "role": "Editor",
        "mimeType": "application/json"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2RkUwQUIzRkJBMUMxMDMKUldRRHdhSDdzd3IrNW0vQW03dzBxem5XQXdsQjd4V2xGVXoxcHk1R2duZE9lYXVGc2FXLzFBeHoK",
      "endpoints": [
        "https://github.com/2imeline/Roblox-UI-Assistant/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
