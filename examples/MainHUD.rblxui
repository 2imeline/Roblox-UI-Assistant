      { "name": "HUDController", "type": "LocalScript", "source": "-- Tidewreck HUD: menu, tabs, market, settings and camera view.\nlocal Players = game:GetService(\"Players\")\nlocal TweenService = game:GetService(\"TweenService\")\nlocal UserInputService = game:GetService(\"UserInputService\")\n\nlocal player = Players.LocalPlayer\nlocal hud = script.Parent\nlocal menu = hud:WaitForChild(\"PlayMenu\")\nlocal playButton = hud:WaitForChild(\"PlayButton\")\nlocal purse = hud:WaitForChild(\"Purse\")\nlocal toast = hud:WaitForChild(\"Toast\")\nlocal viewToggle = hud:WaitForChild(\"ViewToggle\")\nlocal pages = menu:WaitForChild(\"Pages\")\nlocal tabs = menu:WaitForChild(\"Tabs\")\nlocal title = menu.Header.Title\nlocal pop = menu:WaitForChild(\"PopScale\")\n\nlocal TEAL = Color3.fromRGB(24, 96, 104)\nlocal CORAL = Color3.fromRGB(240, 112, 64)\nlocal WOOD = Color3.fromRGB(104, 66, 40)\nlocal FOAM = Color3.fromRGB(255, 250, 240)\nlocal GLASS = Color3.fromRGB(122, 214, 196)\nlocal SWITCH_OFF = Color3.fromRGB(176, 150, 110)\n\nlocal QUICK = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)\nlocal OPEN = TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out)\n\nlocal TITLES = { Voyages = \"Choose a Voyage\", Market = \"Harbor Market\", Settings = \"Ship Settings\" }\n\nlocal function tween(obj, info, goal)\n\tlocal t = TweenService:Create(obj, info, goal)\n\tt:Play()\n\treturn t\nend\n\nlocal function formatNumber(n)\n\tlocal s = tostring(math.floor(n))\n\tlocal k\n\trepeat s, k = s:gsub(\"^(-?%d+)(%d%d%d)\", \"%1,%2\") until k == 0\n\treturn s\nend\n\n-- Doubloons live in an attribute so other scripts can read them.\nlocal function setDoubloons(n)\n\thud:SetAttribute(\"Doubloons\", n)\n\tpurse.Amount.Text = formatNumber(n)\nend\nsetDoubloons(hud:GetAttribute(\"Doubloons\") or 0)\n\n-- Hover and press feedback for every button that has a UIScale.\nfor _, d in hud:GetDescendants() do\n\tif d:IsA(\"GuiButton\") then\n\t\tlocal s = d:FindFirstChildOfClass(\"UIScale\")\n\t\tif s then\n\t\t\td.MouseEnter:Connect(function() tween(s, QUICK, { Scale = 1.05 }) end)\n\t\t\td.MouseLeave:Connect(function() tween(s, QUICK, { Scale = 1 }) end)\n\t\t\td.MouseButton1Down:Connect(function() tween(s, QUICK, { Scale = 0.95 }) end)\n\t\t\td.MouseButton1Up:Connect(function() tween(s, QUICK, { Scale = 1.05 }) end)\n\t\tend\n\tend\nend\n\n-- Toast messages\nlocal toastId = 0\nlocal function showToast(message)\n\ttoastId += 1\n\tlocal id = toastId\n\ttoast.Text = message\n\ttoast.TextTransparency = 1\n\ttoast.BackgroundTransparency = 1\n\ttoast.Visible = true\n\ttween(toast, QUICK, { TextTransparency = 0, BackgroundTransparency = 0.1 })\n\ttask.delay(2.2, function()\n\t\tif id ~= toastId then return end\n\t\ttween(toast, QUICK, { TextTransparency = 1, BackgroundTransparency = 1 }).Completed:Connect(function()\n\t\t\tif id == toastId then toast.Visible = false end\n\t\tend)\n\tend)\nend\n\n-- Tabs\nlocal function selectTab(name)\n\tfor _, page in pages:GetChildren() do\n\t\tif page:IsA(\"GuiObject\") then page.Visible = page.Name == name end\n\tend\n\tfor _, tab in tabs:GetChildren() do\n\t\tif tab:IsA(\"TextButton\") then\n\t\t\tlocal on = tab.Name == name\n\t\t\ttab.BackgroundTransparency = if on then 0 else 1\n\t\t\ttab.TextColor3 = if on then FOAM else WOOD\n\t\tend\n\tend\n\ttitle.Text = TITLES[name] or name\nend\nfor _, tab in tabs:GetChildren() do\n\tif tab:IsA(\"TextButton\") then\n\t\ttab.Activated:Connect(function() selectTab(tab.Name) end)\n\tend\nend\n\n-- Menu open / close\nlocal function openMenu(tab)\n\tselectTab(tab or \"Voyages\")\n\tif menu.Visible then return end\n\tmenu.Visible = true\n\tplayButton.Visible = false\n\tpop.Scale = 0.85\n\ttween(pop, OPEN, { Scale = 1 })\nend\n\nlocal function closeMenu()\n\tif not menu.Visible then return end\n\tplayButton.Visible = true\n\ttween(pop, QUICK, { Scale = 0.85 }).Completed:Connect(function(state)\n\t\tif state == Enum.PlaybackState.Completed then menu.Visible = false end\n\tend)\nend\n\nplayButton.Activated:Connect(function() openMenu(\"Voyages\") end)\nmenu.Header.Close.Activated:Connect(closeMenu)\n\n-- Voyages\nfor _, row in pages.Voyages:GetChildren() do\n\tif row:IsA(\"Frame\") then\n\t\trow.Embark.Activated:Connect(function()\n\t\t\tcloseMenu()\n\t\t\tshowToast(\"Setting sail for \" .. row:GetAttribute(\"Voyage\") .. \"!\")\n\t\tend)\n\tend\nend\n\n-- Market\nfor _, card in pages.Market.Grid:GetChildren() do\n\tif card:IsA(\"Frame\") then\n\t\tlocal buy = card.Buy\n\t\tbuy.Activated:Connect(function()\n\t\t\tif card:GetAttribute(\"Owned\") then return end\n\t\t\tlocal price = card:GetAttribute(\"Price\") or 0\n\t\t\tlocal balance = hud:GetAttribute(\"Doubloons\")\n\t\t\tif balance < price then\n\t\t\t\tshowToast(\"You need \" .. formatNumber(price - balance) .. \" more Doubloons\")\n\t\t\t\treturn\n\t\t\tend\n\t\t\tsetDoubloons(balance - price)\n\t\t\tcard:SetAttribute(\"Owned\", true)\n\t\t\tbuy.Text = \"Owned\"\n\t\t\tbuy.AutoButtonColor = false\n\t\t\ttween(buy, QUICK, { BackgroundColor3 = WOOD })\n\t\t\tshowToast(\"Bought the \" .. card.ItemName.Text)\n\t\tend)\n\tend\nend\n\n-- Settings: sliders\nlocal function slider(row)\n\tlocal track = row.Track\n\tlocal dragging = false\n\tlocal function set(alpha)\n\t\talpha = math.clamp(alpha, 0, 1)\n\t\ttrack.Fill.Size = UDim2.fromScale(alpha, 1)\n\t\ttrack.Knob.Position = UDim2.fromScale(alpha, 0.5)\n\t\trow.Value.Text = math.round(alpha * 100) .. \"%\"\n\t\trow:SetAttribute(\"Value\", alpha)\n\tend\n\tlocal function follow(x)\n\t\tset((x - track.AbsolutePosition.X) / track.AbsoluteSize.X)\n\tend\n\ttrack.InputBegan:Connect(function(input)\n\t\tlocal t = input.UserInputType\n\t\tif t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then\n\t\t\tdragging = true\n\t\t\tfollow(input.Position.X)\n\t\tend\n\tend)\n\tUserInputService.InputChanged:Connect(function(input)\n\t\tlocal t = input.UserInputType\n\t\tif dragging and (t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch) then follow(input.Position.X) end\n\tend)\n\tUserInputService.InputEnded:Connect(function(input)\n\t\tlocal t = input.UserInputType\n\t\tif t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then dragging = false end\n\tend)\n\tset(row:GetAttribute(\"Value\") or 0.5)\nend\n\n-- Settings: on/off switches\nlocal function switch(row)\n\tlocal button = row.Switch\n\tlocal function render()\n\t\tlocal on = row:GetAttribute(\"On\") == true\n\t\ttween(button, QUICK, { BackgroundColor3 = if on then TEAL else SWITCH_OFF })\n\t\ttween(button.Knob, QUICK, {\n\t\t\tAnchorPoint = Vector2.new(if on then 1 else 0, 0.5),\n\t\t\tPosition = UDim2.new(if on then 1 else 0, if on then -4 else 4, 0.5, 0),\n\t\t})\n\tend\n\tbutton.Activated:Connect(function()\n\t\trow:SetAttribute(\"On\", not row:GetAttribute(\"On\"))\n\t\trender()\n\tend)\nend\n\nfor _, row in pages.Settings:GetChildren() do\n\tif row:FindFirstChild(\"Track\") then slider(row) elseif row:FindFirstChild(\"Switch\") then switch(row) end\nend\n\n-- Camera view toggle\nlocal thirdPerson = true\nlocal function toggleView()\n\tthirdPerson = not thirdPerson\n\tplayer.CameraMode = if thirdPerson then Enum.CameraMode.Classic else Enum.CameraMode.LockFirstPerson\n\tviewToggle.Label.Text = if thirdPerson then \"3rd Person\" else \"1st Person\"\n\ttween(viewToggle.Indicator, QUICK, { BackgroundColor3 = if thirdPerson then GLASS else CORAL })\nend\nviewToggle.Activated:Connect(toggleView)\n\n-- Keyboard shortcuts\nUserInputService.InputBegan:Connect(function(input, gameProcessed)\n\tif gameProcessed then return end\n\tif input.KeyCode == Enum.KeyCode.M then\n\t\tif menu.Visible then closeMenu() else openMenu() end\n\telseif input.KeyCode == Enum.KeyCode.V then\n\t\ttoggleView()\n\tend\nend)\n" }
    ]
  },
  "lua": "-- MainHUD — generated by Roblox UI Builder (rblxui/1.0).\n-- Paste into the Roblox Studio command bar (View > Command Bar). Creates the ScreenGui under StarterGui.\nlocal n = {}\nlocal function make(i, class, parent, props)\n\tlocal o = Instance.new(class)\n\tfor k, v in props do o[k] = v end\n\t-- CanvasPosition is clamped to CanvasSize, so apply it after everything else\n\tif props.CanvasPosition then o.CanvasPosition = props.CanvasPosition end\n\tn[i] = o\n\tif parent then o.Parent = n[parent] end\nend\nmake(1, \"ScreenGui\", nil, { Name = \"MainHUD\", ZIndexBehavior = Enum.ZIndexBehavior.Sibling, ResetOnSpawn = false, IgnoreGuiInset = false })\nn[1]:SetAttribute(\"Doubloons\", 1250)\nmake(2, \"Frame\", 1, { Name = \"Purse\", BackgroundColor3 = Color3.fromRGB(244, 228, 193), BorderSizePixel = 0, Size = UDim2.new(0.14, 0, 0.07, 0), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 12) })\nmake(3, \"UICorner\", 2, { Name = \"UICorner\", CornerRadius = UDim.new(0.5, 0) })\nmake(4, \"UIStroke\", 2, { Name = \"UIStroke\", Color = Color3.fromRGB(104, 66, 40), Thickness = 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })\nmake(5, \"UIAspectRatioConstraint\", 2, { Name = \"UIAspectRatioConstraint\", AspectRatio = 3.6 })\nmake(6, \"UISizeConstraint\", 2, { Name = \"UISizeConstraint\", MinSize = Vector2.new(150, 42), MaxSize = Vector2.new(300, 84) })\nmake(7, \"Frame\", 2, { Name = \"Coin\", BackgroundColor3 = Color3.fromRGB(242, 186, 58), BorderSizePixel = 0, Size = UDim2.new(0.62, 0, 0.62, 0), SizeConstraint = Enum.SizeConstraint.RelativeYY, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0.07, 0, 0.5, 0) })\nmake(8, \"UICorner\", 7, { Name = \"UICorner\", CornerRadius = UDim.new(0.5, 0) })\nmake(9, \"UIStroke\", 7, { Name = \"UIStroke\", Color = Color3.fromRGB(104, 66, 40), Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })\nmake(10, \"Frame\", 7, { Name = \"Mark\", BackgroundColor3 = Color3.fromRGB(255, 214, 110), BorderSizePixel = 0, Size = UDim2.new(0.46, 0, 0.46, 0), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0) })\nmake(11, \"UICorner\", 10, { Name = \"UICorner\", CornerRadius = UDim.new(0.5, 0) })\nmake(12, \"TextLabel\", 2, { Name = \"Amount\", BackgroundColor3 = Color3.fromRGB(163, 162, 165), BorderSizePixel = 0, Size = UDim2.new(0.6, 0, 0.6, 0), FontFace = Font.new(\"rbxasset://fonts/families/Nunito.json\", Enum.FontWeight.ExtraBold, Enum.FontStyle.Normal), Text = \"1,250\", TextColor3 = Color3.fromRGB(104, 66, 40), TextSize = 14, BackgroundTransparency = 1, TextScaled = true, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(0.9, 0, 0.5, 0), TextXAlignment = Enum.TextXAlignment.Right })\nmake(13, \"UITextSizeConstraint\", 12, { Name = \"UITextSizeConstraint\", MaxTextSize = 34, MinTextSize = 8 })\nmake(14, \"TextButton\", 1, { Name = \"ViewToggle\", BackgroundColor3 = Color3.fromRGB(24, 96, 104), BorderSizePixel = 0, Size = UDim2.new(0.13, 0, 0.075, 0), FontFace = Font.new(\"rbxasset://fonts/families/LegacyArial.json\", Enum.FontWeight.Regular, Enum.FontStyle.Normal), Text = \"\", TextColor3 = Color3.fromRGB(27, 42, 53), TextSize = 14, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 16, 1, -16), AutoButtonColor = true })\nmake(15, \"UICorner\", 14, { Name = \"UICorner\", CornerRadius = UDim.new(0, 6) })\nmake(16, \"UIStroke\", 14, { Name = \"UIStroke\", Color = Color3.fromRGB(104, 66, 40), Thickness = 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })\nmake(17, \"UIScale\", 14, { Name = \"UIScale\" })\nmake(18, \"UIAspectRatioConstraint\", 14, { Name = \"UIAspectRatioConstraint\", AspectRatio = 3.2 })\nmake(19, \"UISizeConstraint\", 14, { Name = \"UISizeConstraint\", MinSize = Vector2.new(150, 46), MaxSize = Vector2.new(280, 88) })\nmake(20, \"Frame\", 14, { Name = \"Indicator\", BackgroundColor3 = Color3.fromRGB(122, 214, 196), BorderSizePixel = 0, Size = UDim2.new(0.4, 0, 0.4, 0), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0.07, 0, 0.5, 0), SizeConstraint = Enum.SizeConstraint.RelativeYY })\nmake(21, \"UICorner\", 20, { Name = \"UICorner\", CornerRadius = UDim.new(0.5, 0) })\nmake(22, \"UIStroke\", 20, { Name = \"UIStroke\", Color = Color3.fromRGB(104, 66, 40), Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })\nmake(23, \"TextLabel\", 14, { Name = \"Label\", BackgroundColor3 = Color3.fromRGB(163, 162, 165), BorderSizePixel = 0, Size = UDim2.new(0.68, 0, 0.46, 0), FontFace = Font.new(\"rbxasset://fonts/families/Nunito.json\", Enum.FontWeight.Bold, Enum.FontStyle.Normal), Text = \"3rd Person\", TextColor3 = Color3.fromRGB(255, 250, 240), TextSize = 14, BackgroundTransparency = 1, TextScaled = true, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0.25, 0, 0.5, 0), TextXAlignment = Enum.TextXAlignment.Left })\nmake(24, \"UITextSizeConstraint\", 23, { Name = \"UITextSizeConstraint\", MaxTextSize = 26, MinTextSize = 8 })\nmake(25, \"TextButton\", 1, { Name = \"PlayButton\", BackgroundColor3 = Color3.fromRGB(240, 112, 64), BorderSizePixel = 0, Size = UDim2.new(0.2, 0, 0.11, 0), FontFace = Font.new(\"rbxasset://fonts/families/LuckiestGuy.json\", Enum.FontWeight.Regular, Enum.FontStyle.Normal), Text = \"Set Sail\", TextColor3 = Color3.fromRGB(255, 250, 240), TextSize = 14, TextScaled = true, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -24), TextStrokeColor3 = Color3.fromRGB(104, 66, 40), TextStrokeTransparency = 0 })\nmake(26, \"UICorner\", 25, { Name = \"UICorner\", CornerRadius = UDim.new(0.5, 0) })\nmake(27, \"UIStroke\", 25, { Name = \"UIStroke\", Color = Color3.fromRGB(104, 66, 40), Thickness = 4, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })\nmake(28, \"UITextSizeConstraint\", 25, { Name = \"UITextSizeConstraint\", MaxTextSize = 54, MinTextSize = 8 })\nmake(29, \"UIScale\", 25, { Name = \"UIScale\" })\nmake(30, \"UIPadding\", 25, { Name = \"UIPadding\", PaddingTop = UDim.new(0.16, 0), PaddingBottom = UDim.new(0.16, 0), PaddingLeft = UDim.new(0.08, 0), PaddingRight = UDim.new(0.08, 0) })\nmake(31, \"UIAspectRatioConstraint\", 25, { Name = \"UIAspectRatioConstraint\", AspectRatio = 3.4 })\nmake(32, \"UISizeConstraint\", 25, { Name = \"UISizeConstraint\", MinSize = Vector2.new(180, 54), MaxSize = Vector2.new(380, 112) })\nmake(33, \"TextLabel\", 1, { Name = \"Toast\", BackgroundColor3 = Color3.fromRGB(104, 66, 40), BorderSizePixel = 0, Size = UDim2.new(0.34, 0, 0.06, 0), FontFace = Font.new(\"rbxasset://fonts/families/Nunito.json\", Enum.FontWeight.Bold, Enum.FontStyle.Normal), Text = \"\", TextColor3 = Color3.fromRGB(255, 250, 240), TextSize = 14, BackgroundTransparency = 1, TextScaled = true, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 12), Visible = false })\nmake(34, \"UITextSizeConstraint\", 33, { Name = \"UITextSizeConstraint\", MaxTextSize = 26, MinTextSize = 8 })\nmake(35, \"UICorner\", 33, { Name = \"UICorner\", CornerRadius = UDim.new(0, 6) })\nmake(36, \"UIAspectRatioConstraint\", 33, { Name = \"UIAspectRatioConstraint\", AspectRatio = 9 })\nmake(37, \"UISizeConstraint\", 33, { Name = \"UISizeConstraint\", MinSize = Vector2.new(260, 34), MaxSize = Vector2.new(640, 72) })\nmake(38, \"UIPadding\", 33, { Name = \"UIPadding\", PaddingLeft = UDim.new(0.04, 0), PaddingRight = UDim.new(0.04, 0), PaddingTop = UDim.new(0.18, 0), PaddingBottom = UDim.new(0.18, 0) })\nmake(39, \"Frame\", 1, { Name = \"PlayMenu\", BackgroundColor3 = Color3.fromRGB(244, 228, 193), BorderSizePixel = 0, Size = UDim2.new(0.62, 0, 0.84, 0), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Visible = false, ZIndex = 5 })\nmake(40, \"UICorner\", 39, { Name = \"UICorner\", CornerRadius = UDim.new(0, 20) })\nmake(41, \"UIStroke\", 39, { Name = \"UIStroke\", Color = Color3.fromRGB(104, 66, 40), Thickness = 4, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })\nmake(42, \"UIAspectRatioConstraint\", 39, { Name = \"UIAspectRatioConstraint\", AspectRatio = 1.55 })\nmake(43, \"UISizeConstraint\", 39, { Name = \"UISizeConstraint\", MaxSize = Vector2.new(1040, 680) })\nmake(44, \"UIScale\", 39, { Name = \"PopScale\" })\nmake(45, \"Frame\", 39, { Name = \"Header\", BackgroundColor3 = Color3.fromRGB(24, 96, 104), BorderSizePixel = 0, Size = UDim2.new(1, 0, 0.17, 0) })\nmake(46, \"UICorner\", 45, { Name = \"UICorner\", CornerRadius = UDim.new(0, 20) })\nmake(47, \"Frame\", 45, { Name = \"SquareEdge\", BackgroundColor3 = Color3.fromRGB(24, 96, 104), BorderSizePixel = 0, Size = UDim2.new(1, 0, 0.5, 0), AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0) })\nmake(48, \"TextLabel\", 45, { Name = \"Title\", BackgroundColor3 = Color3.fromRGB(163, 162, 165), BorderSizePixel = 0, Size = UDim2.new(0.7, 0, 0.6, 0), FontFace = Font.new(\"rbxasset://fonts/families/LuckiestGuy.json\", Enum.FontWeight.Regular, Enum.FontStyle.Normal), Text = \"Choose a Voyage\", TextColor3 = Color3.fromRGB(255, 250, 240), TextSize = 14, BackgroundTransparency = 1, TextScaled = true, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0.04, 0, 0.5, 0), TextXAlignment = Enum.TextXAlignment.Left, TextStrokeColor3 = Color3.fromRGB(104, 66, 40), TextStrokeTransparency = 0, ZIndex = 2 })\nmake(49, \"UITextSizeConstraint\", 48, { Name = \"UITextSizeConstraint\", MaxTextSize = 48, MinTextSize = 8 })\nmake(50, \"TextButton\", 45, { Name = \"Close\", BackgroundColor3 = Color3.fromRGB(244, 228, 193), BorderSizePixel = 0, Size = UDim2.new(0.56, 0, 0.56, 0), FontFace = Font.new(\"rbxasset://fonts/families/LegacyArial.json\", Enum.FontWeight.Regular, Enum.FontStyle.Normal), Text = \"\", TextColor3 = Color3.fromRGB(27, 42, 53), TextSize = 14, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(0.975, 0, 0.5, 0), SizeConstraint = Enum.SizeConstraint.RelativeYY, ZIndex = 2 })\nmake(51, \"UICorner\", 50, { Name = \"UICorner\", CornerRadius = UDim.new(0, 6) })\nmake(52, \"UIStroke\", 50, { Name = \"UIStroke\", Color = Color3.fromRGB(104, 66, 40), Thickness = 3, ApplyStrokeMode