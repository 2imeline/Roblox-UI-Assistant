\", BackgroundColor3 = Color3.fromRGB(163, 162, 165), BorderSizePixel = 0, Size = UDim2.new(0.26, 0, 0.55, 0), FontFace = Font.new(\"rbxasset://fonts/families/Nunito.json\", Enum.FontWeight.ExtraBold, Enum.FontStyle.Normal), Text = \"Sound Effects\", TextColor3 = Color3.fromRGB(104, 66, 40), TextSize = 14, BackgroundTransparency = 1, TextScaled = true, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), TextXAlignment = Enum.TextXAlignment.Left })\nmake(332, \"UITextSizeConstraint\", 331, { Name = \"UITextSizeConstraint\", MaxTextSize = 24, MinTextSize = 8 })\nmake(333, \"Frame\", 330, { Name = \"Track\", BackgroundColor3 = Color3.fromRGB(200, 176, 132), BorderSizePixel = 0, Size = UDim2.new(0.52, 0, 0.22, 0), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0.3, 0, 0.5, 0) })\nmake(334, \"UICorner\", 333, { Name = \"UICorner\", CornerRadius = UDim.new(0.5, 0) })\nmake(335, \"Frame\", 333, { Name = \"Fill\", BackgroundColor3 = Color3.fromRGB(24, 96, 104), BorderSizePixel = 0, Size = UDim2.new(0.8, 0, 1, 0) })\nmake(336, \"UICorner\", 335, { Name = \"UICorner\", CornerRadius = UDim.new(0.5, 0) })\nmake(337, \"Frame\", 333, { Name = \"Knob\", BackgroundColor3 = Color3.fromRGB(255, 250, 240), BorderSizePixel = 0, Size = UDim2.new(2, 0, 2, 0), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.8, 0, 0.5, 0), SizeConstraint = Enum.SizeConstraint.RelativeYY, ZIndex = 2 })\nmake(338, \"UICorner\", 337, { Name = \"UICorner\", CornerRadius = UDim.new(0.5, 0) })\nmake(339, \"UIStroke\", 337, { Name = \"UIStroke\", Color = Color3.fromRGB(104, 66, 40), Thickness = 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })\nmake(340, \"TextLabel\", 330, { Name = \"Value\", BackgroundColor3 = Color3.fromRGB(163, 162, 165), BorderSizePixel = 0, Size = UDim2.new(0.12, 0, 0.5, 0), FontFace = Font.new(\"rbxasset://fonts/families/Nunito.json\", Enum.FontWeight.Bold, Enum.FontStyle.Normal), Text = \"80%\", TextColor3 = Color3.fromRGB(104, 66, 40), TextSize = 14, BackgroundTransparency = 1, TextScaled = true, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), TextXAlignment = Enum.TextXAlignment.Right })\nmake(341, \"UITextSizeConstraint\", 340, { Name = \"UITextSizeConstraint\", MaxTextSize = 22, MinTextSize = 8 })\nmake(342, \"Frame\", 315, { Name = \"DamageNumbers\", BackgroundColor3 = Color3.fromRGB(163, 162, 165), BorderSizePixel = 0, Size = UDim2.new(1, 0, 0.17, 0), LayoutOrder = 3, BackgroundTransparency = 1 })\nn[342]:SetAttribute(\"On\", true)\nmake(343, \"TextLabel\", 342, { Name = \"Label\", BackgroundColor3 = Color3.fromRGB(163, 162, 165), BorderSizePixel = 0, Size = UDim2.new(0.26, 0, 0.55, 0), FontFace = Font.new(\"rbxasset://fonts/families/Nunito.json\", Enum.FontWeight.ExtraBold, Enum.FontStyle.Normal), Text = \"Damage Numbers\", TextColor3 = Color3.fromRGB(104, 66, 40), TextSize = 14, BackgroundTransparency = 1, TextScaled = true, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), TextXAlignment = Enum.TextXAlignment.Left })\nmake(344, \"UITextSizeConstraint\", 343, { Name = \"UITextSizeConstraint\", MaxTextSize = 24, MinTextSize = 8 })\nmake(345, \"TextButton\", 342, { Name = \"Switch\", BackgroundColor3 = Color3.fromRGB(24, 96, 104), BorderSizePixel = 0, Size = UDim2.new(1.25, 0, 0.62, 0), FontFace = Font.new(\"rbxasset://fonts/families/LegacyArial.json\", Enum.FontWeight.Regular, Enum.FontStyle.Normal), Text = \"\", TextColor3 = Color3.fromRGB(27, 42, 53), TextSize = 14, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0.3, 0, 0.5, 0), SizeConstraint = Enum.SizeConstraint.RelativeYY, AutoButtonColor = false })\nmake(346, \"UICorner\", 345, { Name = \"UICorner\", CornerRadius = UDim.new(0.5, 0) })\nmake(347, \"UIStroke\", 345, { Name = \"UIStroke\", Color = Color3.fromRGB(104, 66, 40), Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })\nmake(348, \"Frame\", 345, { Name = \"Knob\", BackgroundColor3 = Color3.fromRGB(255, 250, 240), BorderSizePixel = 0, Size = UDim2.new(0.74, 0, 0.74, 0), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -4, 0.5, 0), SizeConstraint = Enum.SizeConstraint.RelativeYY })\nmake(349, \"UICorner\", 348, { Name = \"UICorner\", CornerRadius = UDim.new(0.5, 0) })\nmake(350, \"Frame\", 315, { Name = \"CameraShake\", BackgroundColor3 = Color3.fromRGB(163, 162, 165), BorderSizePixel = 0, Size = UDim2.new(1, 0, 0.17, 0), LayoutOrder = 4, BackgroundTransparency = 1 })\nn[350]:SetAttribute(\"On\", false)\nmake(351, \"TextLabel\", 350, { Name = \"Label\", BackgroundColor3 = Color3.fromRGB(163, 162, 165), BorderSizePixel = 0, Size = UDim2.new(0.26, 0, 0.55, 0), FontFace = Font.new(\"rbxasset://fonts/families/Nunito.json\", Enum.FontWeight.ExtraBold, Enum.FontStyle.Normal), Text = \"Camera Shake\", TextColor3 = Color3.fromRGB(104, 66, 40), TextSize = 14, BackgroundTransparency = 1, TextScaled = true, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), TextXAlignment = Enum.TextXAlignment.Left })\nmake(352, \"UITextSizeConstraint\", 351, { Name = \"UITextSizeConstraint\", MaxTextSize = 24, MinTextSize = 8 })\nmake(353, \"TextButton\", 350, { Name = \"Switch\", BackgroundColor3 = Color3.fromRGB(176, 150, 110), BorderSizePixel = 0, Size = UDim2.new(1.25, 0, 0.62, 0), FontFace = Font.new(\"rbxasset://fonts/families/LegacyArial.json\", Enum.FontWeight.Regular, Enum.FontStyle.Normal), Text = \"\", TextColor3 = Color3.fromRGB(27, 42, 53), TextSize = 14, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0.3, 0, 0.5, 0), SizeConstraint = Enum.SizeConstraint.RelativeYY, AutoButtonColor = false })\nmake(354, \"UICorner\", 353, { Name = \"UICorner\", CornerRadius = UDim.new(0.5, 0) })\nmake(355, \"UIStroke\", 353, { Name = \"UIStroke\", Color = Color3.fromRGB(104, 66, 40), Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })\nmake(356, \"Frame\", 353, { Name = \"Knob\", BackgroundColor3 = Color3.fromRGB(255, 250, 240), BorderSizePixel = 0, Size = UDim2.new(0.74, 0, 0.74, 0), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 4, 0.5, 0), SizeConstraint = Enum.SizeConstraint.RelativeYY })\nmake(357, \"UICorner\", 356, { Name = \"UICorner\", CornerRadius = UDim.new(0.5, 0) })\nmake(358, \"TextLabel\", 39, { Name = \"Hint\", BackgroundColor3 = Color3.fromRGB(163, 162, 165), BorderSizePixel = 0, Size = UDim2.new(0.9, 0, 0.035, 0), FontFace = Font.new(\"rbxasset://fonts/families/Nunito.json\", Enum.FontWeight.Regular, Enum.FontStyle.Normal), Text = \"M opens this menu  ·  V switches the camera view\", TextColor3 = Color3.fromRGB(104, 66, 40), TextSize = 14, BackgroundTransparency = 1, TextScaled = true, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0.985, 0), TextTransparency = 0.4 })\nmake(359, \"UITextSizeConstraint\", 358, { Name = \"UITextSizeConstraint\", MaxTextSize = 16, MinTextSize = 8 })\nmake(360, \"LocalScript\", 1, { Name = \"HUDController\", Source = [=[\n-- Tidewreck HUD: menu, tabs, market, settings and camera view.\nlocal Players = game:GetService(\"Players\")\nlocal TweenService = game:GetService(\"TweenService\")\nlocal UserInputService = game:GetService(\"UserInputService\")\n\nlocal player = Players.LocalPlayer\nlocal hud = script.Parent\nlocal menu = hud:WaitForChild(\"PlayMenu\")\nlocal playButton = hud:WaitForChild(\"PlayButton\")\nlocal purse = hud:WaitForChild(\"Purse\")\nlocal toast = hud:WaitForChild(\"Toast\")\nlocal viewToggle = hud:WaitForChild(\"ViewToggle\")\nlocal pages = menu:WaitForChild(\"Pages\")\nlocal tabs = menu:WaitForChild(\"Tabs\")\nlocal title = menu.Header.Title\nlocal pop = menu:WaitForChild(\"PopScale\")\n\nlocal TEAL = Color3.fromRGB(24, 96, 104)\nlocal CORAL = Color3.fromRGB(240, 112, 64)\nlocal WOOD = Color3.fromRGB(104, 66, 40)\nlocal FOAM = Color3.fromRGB(255, 250, 240)\nlocal GLASS = Color3.fromRGB(122, 214, 196)\nlocal SWITCH_OFF = Color3.fromRGB(176, 150, 110)\n\nlocal QUICK = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)\nlocal OPEN = TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out)\n\nlocal TITLES = { Voyages = \"Choose a Voyage\", Market = \"Harbor Market\", Settings = \"Ship Settings\" }\n\nlocal function tween(obj, info, goal)\n\tlocal t = TweenService:Create(obj, info, goal)\n\tt:Play()\n\treturn t\nend\n\nlocal function formatNumber(n)\n\tlocal s = tostring(math.floor(n))\n\tlocal k\n\trepeat s, k = s:gsub(\"^(-?%d+)(%d%d%d)\", \"%1,%2\") until k == 0\n\treturn s\nend\n\n-- Doubloons live in an attribute so other scripts can read them.\nlocal function setDoubloons(n)\n\thud:SetAttribute(\"Doubloons\", n)\n\tpurse.Amount.Text = formatNumber(n)\nend\nsetDoubloons(hud:GetAttribute(\"Doubloons\") or 0)\n\n-- Hover and press feedback for every button that has a UIScale.\nfor _, d in hud:GetDescendants() do\n\tif d:IsA(\"GuiButton\") then\n\t\tlocal s = d:FindFirstChildOfClass(\"UIScale\")\n\t\tif s then\n\t\t\td.MouseEnter:Connect(function() tween(s, QUICK, { Scale = 1.05 }) end)\n\t\t\td.MouseLeave:Connect(function() tween(s, QUICK, { Scale = 1 }) end)\n\t\t\td.MouseButton1Down:Connect(function() tween(s, QUICK, { Scale = 0.95 }) end)\n\t\t\td.MouseButton1Up:Connect(function() tween(s, QUICK, { Scale = 1.05 }) end)\n\t\tend\n\tend\nend\n\n-- Toast messages\nlocal toastId = 0\nlocal function showToast(message)\n\ttoastId += 1\n\tlocal id = toastId\n\ttoast.Text = message\n\ttoast.TextTransparency = 1\n\ttoast.BackgroundTransparency = 1\n\ttoast.Visible = true\n\ttween(toast, QUICK, { TextTransparency = 0, BackgroundTransparency = 0.1 })\n\ttask.delay(2.2, function()\n\t\tif id ~= toastId then return end\n\t\ttween(toast, QUICK, { TextTransparency = 1, BackgroundTransparency = 1 }).Completed:Connect(function()\n\t\t\tif id == toastId then toast.Visible = false end\n\t\tend)\n\tend)\nend\n\n-- Tabs\nlocal function selectTab(name)\n\tfor _, page in pages:GetChildren() do\n\t\tif page:IsA(\"GuiObject\") then page.Visible = page.Name == name end\n\tend\n\tfor _, tab in tabs:GetChildren() do\n\t\tif tab:IsA(\"TextButton\") then\n\t\t\tlocal on = tab.Name == name\n\t\t\ttab.BackgroundTransparency = if on then 0 else 1\n\t\t\ttab.TextColor3 = if on then FOAM else WOOD\n\t\tend\n\tend\n\ttitle.Text = TITLES[name] or name\nend\nfor _, tab in tabs:GetChildren() do\n\tif tab:IsA(\"TextButton\") then\n\t\ttab.Activated:Connect(function() selectTab(tab.Name) end)\n\tend\nend\n\n-- Menu open / close\nlocal function openMenu(tab)\n\tselectTab(tab or \"Voyages\")\n\tif menu.Visible then return end\n\tmenu.Visible = true\n\tplayButton.Visible = false\n\tpop.Scale = 0.85\n\ttween(pop, OPEN, { Scale = 1 })\nend\n\nlocal function closeMenu()\n\tif not menu.Visible then return end\n\tplayButton.Visible = true\n\ttween(pop, QUICK, { Scale = 0.85 }).Completed:Connect(function(state)\n\t\tif state == Enum.PlaybackState.Completed then menu.Visible = false end\n\tend)\nend\n\nplayButton.Activated:Connect(function() openMenu(\"Voyages\") end)\nmenu.Header.Close.Activated:Connect(closeMenu)\n\n-- Voyages\nfor _, row in pages.Voyages:GetChildren() do\n\tif row:IsA(\"Frame\") then\n\t\trow.Embark.Activated:Connect(function()\n\t\t\tcloseMenu()\n\t\t\tshowToast(\"Setting sail for \" .. row:GetAttribute(\"Voyage\") .. \"!\")\n\t\tend)\n\tend\nend\n\n-- Market\nfor _, card in pages.Market.Grid:GetChildren() do\n\tif card:IsA(\"Frame\") then\n\t\tlocal buy = card.Buy\n\t\tbuy.Activated:Connect(function()\n\t\t\tif card:GetAttribute(\"Owned\") then return end\n\t\t\tlocal price = card:GetAttribute(\"Price\") or 0\n\t\t\tlocal balance = hud:GetAttribute(\"Doubloons\")\n\t\t\tif balance < price then\n\t\t\t\tshowToast(\"You need \" .. formatNumber(price - balance) .. \" more Doubloons\")\n\t\t\t\treturn\n\t\t\tend\n\t\t\tsetDoubloons(balance - price)\n\t\t\tcard:SetAttribute(\"Owned\", true)\n\t\t\tbuy.Text = \"Owned\"\n\t\t\tbuy.AutoButtonColor = false\n\t\t\ttween(buy, QUICK, { BackgroundColor3 = WOOD })\n\t\t\tshowToast(\"Bought the \" .. card.ItemName.Text)\n\t\tend)\n\tend\nend\n\n-- Settings: sliders\nlocal function slider(row)\n\tlocal track = row.Track\n\tlocal dragging = false\n\tlocal function set(alpha)\n\t\talpha = math.clamp(alpha, 0, 1)\n\t\ttrack.Fill.Size = UDim2.fromScale(alpha, 1)\n\t\ttrack.Knob.Position = UDim2.fromScale(alpha, 0.5)\n\t\trow.Value.Text = math.round(alpha * 100) .. \"%\"\n\t\trow:SetAttribute(\"Value\", alpha)\n\tend\n\tlocal function follow(x)\n\t\tset((x - track.AbsolutePosition.X) / track.AbsoluteSize.X)\n\tend\n\ttrack.InputBegan:Connect(function(input)\n\t\tlocal t = input.UserInputType\n\t\tif t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then\n\t\t\tdragging = true\n\t\t\tfollow(input.Position.X)\n\t\tend\n\tend)\n\tUserInputService.InputChanged:Connect(function(input)\n\t\tlocal t = input.UserInputType\n\t\tif dragging and (t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch) then follow(input.Position.X) end\n\tend)\n\tUserInputService.InputEnded:Connect(function(input)\n\t\tlocal t = input.UserInputType\n\t\tif t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then dragging = false end\n\tend)\n\tset(row:GetAttribute(\"Value\") or 0.5)\nend\n\n-- Settings: on/off switches\nlocal function switch(row)\n\tlocal button = row.Switch\n\tlocal function render()\n\t\tlocal on = row:GetAttribute(\"On\") == true\n\t\ttween(button, QUICK, { BackgroundColor3 = if on then TEAL else SWITCH_OFF })\n\t\ttween(button.Knob, QUICK, {\n\t\t\tAnchorPoint = Vector2.new(if on then 1 else 0, 0.5),\n\t\t\tPosition = UDim2.new(if on then 1 else 0, if on then -4 else 4, 0.5, 0),\n\t\t})\n\tend\n\tbutton.Activated:Connect(function()\n\t\trow:SetAttribute(\"On\", not row:GetAttribute(\"On\"))\n\t\trender()\n\tend)\nend\n\nfor _, row in pages.Settings:GetChildren() do\n\tif row:FindFirstChild(\"Track\") then slider(row) elseif row:FindFirstChild(\"Switch\") then switch(row) end\nend\n\n-- Camera view toggle\nlocal thirdPerson = true\nlocal function toggleView()\n\tthirdPerson = not thirdPerson\n\tplayer.CameraMode = if thirdPerson then Enum.CameraMode.Classic else Enum.CameraMode.LockFirstPerson\n\tviewToggle.Label.Text = if thirdPerson then \"3rd Person\" else \"1st Person\"\n\ttween(viewToggle.Indicator, QUICK, { BackgroundColor3 = if thirdPerson then GLASS else CORAL })\nend\nviewToggle.Activated:Connect(toggleView)\n\n-- Keyboard shortcuts\nUserInputService.InputBegan:Connect(function(input, gameProcessed)\n\tif gameProcessed then return end\n\tif input.KeyCode == Enum.KeyCode.M then\n\t\tif menu.Visible then closeMenu() else openMenu() end\n\telseif input.KeyCode == Enum.KeyCode.V then\n\t\ttoggleView()\n\tend\nend)\n]=] })\nn[1].Parent = game:GetService(\"StarterGui\")\nprint(\"Created StarterGui.\" .. n[1].Name)\n"
}
